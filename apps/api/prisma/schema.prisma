// 대한의사협회 협회장 선거 시스템 - 데이터 모델
//
// [핵심 원칙] Voter 와 Ballot 은 절대 연결되지 않는다.
//   - Voter  : "이 회원이 투표를 했는가?"  (중복 투표 차단용)
//   - Ballot : "누구에게 표가 갔는가?"      (개표용)
//   두 테이블 사이에 FK, 공통 컬럼, 순번 상관관계를 두지 않는다.
//   DB 전체를 덤프해도 개인의 선택을 복원할 수 없어야 비밀투표가 성립한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 런타임은 풀링 연결(-pooler). 1만명 동시 접속에서 커넥션 고갈을 막는다.
  url       = env("DATABASE_URL")
  // 마이그레이션은 직접 연결. PgBouncer 를 통하면 DDL 이 실패한다.
  directUrl = env("DIRECT_URL")
}

enum ElectionStatus {
  DRAFT      // 준비중 (명부 업로드, 후보 등록)
  OPEN       // 투표 진행중
  CLOSED     // 투표 마감 (아직 개표 전)
  TALLIED    // 개표 완료 (결과 공개)
}

model Election {
  id          String         @id @default(uuid())
  title       String
  description String?
  status      ElectionStatus @default(DRAFT)

  startsAt    DateTime
  endsAt      DateTime

  /// 투표지 봉인용 X25519 공개키 (base64url).
  /// 짝이 되는 개인키는 이 DB 어디에도 없다. 선관위가 오프라인으로 보관하다가
  /// 개표 시점에만 주입한다. 서버가 개인키를 들고 있으면
  /// 서버를 뚫은 사람이 곧 중간 집계를 볼 수 있어 암호화한 의미가 없어진다.
  ballotPublicKey String?

  /// 개봉에 실패했거나 명부에 없는 후보가 담긴 표의 수.
  /// 봉인을 브라우저가 하므로 서버는 투표 시점에 내용을 검증할 수 없다.
  /// 0 이 아니면 반드시 원인을 조사해야 한다.
  invalidVotes Int @default(0)

  // 개표는 명시적 행위여야 한다. 마감 전 중간 집계 노출은 선거에 영향을 준다.
  talliedAt   DateTime?
  talliedBy   String?

  candidates  Candidate[]
  voters      Voter[]
  ballots     Ballot[]
  approvals   TallyApproval[]
  results     TallyResult[]
  checkpoints Checkpoint[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Candidate {
  id          String   @id @default(uuid())
  electionId  String
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  ballotNumber Int     // 기호 1번, 2번...
  name         String
  affiliation  String? // 소속 / 경력 요약
  pledge       String? @db.Text
  photoUrl     String?

  results      TallyResult[]

  @@unique([electionId, ballotNumber])
  @@index([electionId])
}

// ─────────────────────────────────────────────────────────────
// 유권자 명부 : "누가 투표했는가"
// ─────────────────────────────────────────────────────────────
model Voter {
  id          String   @id @default(uuid())
  electionId  String
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  // 회원번호/휴대폰은 평문 저장하지 않는다. 조회는 해시 일치로만 한다.
  memberNoHash String  // HMAC-SHA256(회원번호, VOTER_ID_PEPPER)
  phoneHash    String  // HMAC-SHA256(E.164 휴대폰, VOTER_ID_PEPPER)
  phoneLast4   String  // "010-****-1234" 마스킹 표시용
  nameMasked   String  // "홍*동" - 본인 확인 화면 표시용

  /// 생년월일 해시 (YYYYMMDD).
  /// 문자를 받았다는 것만으로는 본인임이 증명되지 않는다 — 폰을 주웠거나,
  /// 명부의 번호가 낡아 지금은 남의 번호일 수 있다. 아는 사람만 아는 값을
  /// 하나 더 요구해 그런 경우를 걸러낸다.
  /// (가족 대리투표까지 막지는 못한다. 그건 본인확인 서비스의 몫이다 — README 4장)
  birthDateHash String

  /// 이름 해시. 본인확인 서비스가 돌려준 통신사 명의와 대조하는 데 쓴다.
  /// nameMasked("홍*동")로는 서로 다른 이름이 같은 값이 되어 대조가 되지 않는다.
  nameHash      String?

  /// 본인확인 서비스가 돌려준 CI(연계정보)의 해시.
  /// 같은 사람이 다른 회원번호로 명부에 두 번 있으면 여기서 걸린다.
  /// CI 자체는 주민등록번호 파생값이라 저장하지 않는다 — 해시만 둔다.
  ciHash             String?
  identityVerifiedAt DateTime?

  // ── 중복 투표 차단의 유일한 근거 ──
  hasVoted    Boolean  @default(false)
  votedAt     DateTime?   // 투표 "여부"의 시각. Ballot 과 대조되지 않도록 Ballot 은 시각을 뭉갠다.

  // 인증 상태
  otpHash        String?
  otpExpiresAt   DateTime?
  otpAttempts    Int      @default(0)
  otpSentCount   Int      @default(0)
  lockedUntil    DateTime?

  createdAt   DateTime @default(now())

  @@unique([electionId, memberNoHash])
  /// 휴대폰은 로그인 키다. 한 번호에 두 회원이 걸리면 그 폰을 쥔 사람이
  /// 두 명 몫을 투표할 수 있으므로, 명부 단계에서 원천 차단한다.
  @@unique([electionId, phoneHash])
  /// 한 사람이 다른 회원번호로 두 번 등록되어 두 표를 던지는 것을 막는다.
  /// (CI 는 사람 단위 식별자라 번호를 바꿔도 같다)
  @@unique([electionId, ciHash])
  @@index([electionId, hasVoted])
}

// ─────────────────────────────────────────────────────────────
// 투표지 : "무엇을 찍었는가"
//   voterId 컬럼이 존재하지 않는다. 추가하지 말 것.
// ─────────────────────────────────────────────────────────────
model Ballot {
  id          String    @id @default(uuid())
  electionId  String
  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)

  /// 봉인된 표 (100바이트).
  ///   일회용공개키(32) || nonce(12) || 암호문(40) || 인증태그(16)
  ///
  /// 후보 ID 를 평문으로 두면 DB 를 읽을 수 있는 사람이
  /// `SELECT candidateId, COUNT(*)` 한 줄로 개표 전 중간 집계를 볼 수 있다.
  /// 표마다 일회용 키를 쓰므로 같은 후보를 찍어도 암호문이 매번 다르고,
  /// 선택과 기권의 길이가 같아 길이로도 구분되지 않는다.
  sealedVote  Bytes

  // 정확한 타임스탬프를 남기면 서버 접속 로그의 로그인 시각과 대조해
  // "몇 시 몇 분 몇 초에 로그인한 사람 = 그 직후 들어온 표" 매칭이 가능해진다.
  // 그래서 시(hour) 단위로만 기록한다.
  castAtHour  DateTime

  @@index([electionId])
}

/// 개표 결과. 개봉한 표를 세어 집계만 남긴다.
/// 복호화된 개별 표는 어디에도 저장하지 않는다 — 저장하는 순간
/// 암호화로 얻은 것이 전부 사라진다.
model TallyResult {
  id          String    @id @default(uuid())
  electionId  String
  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)

  candidateId String?   // null = 기권
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  votes       Int

  @@unique([electionId, candidateId])
  @@index([electionId])
}

// ─────────────────────────────────────────────────────────────
// 감사 로그 : 개인 식별 정보 없이 사건만 기록
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  electionId String?
  action     String   // OTP_SENT, LOGIN_OK, LOGIN_FAIL, VOTE_CAST, DUPLICATE_BLOCKED, TALLY, ROSTER_IMPORT
  actorType  String   // VOTER | ADMIN | SYSTEM
  actorRef   String?  // 관리자 ID. VOTER 인 경우 절대 채우지 않는다.
  detail     Json?
  ipPrefix   String?  // "203.0.113.0/24" - 전체 IP 아닌 프리픽스만
  createdAt  DateTime @default(now())

  @@index([electionId, action, createdAt])
}

enum AdminRole {
  COMMISSIONER // 선관위원 — 명부 등록·개시·마감·개표 승인
  AUDITOR      // 참관인 — 읽기 전용. 아무것도 바꿀 수 없다
}

model AdminUser {
  id           String    @id @default(uuid())
  loginId      String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(COMMISSIONER)

  // ── 2차 인증 ──
  // 선관위 계정 하나가 뚫리면 선거 전체가 무너진다. TOTP 는 선택이 아니다.
  totpSecret      String?   // base32. null 이면 아직 등록 전
  totpConfirmedAt DateTime? // null 이면 로그인 시 등록을 강제한다
  // 같은 6자리 코드를 유효시간 안에 두 번 쓰지 못하게 막는다.
  // 어깨너머로 코드를 본 사람이 30초 안에 재사용하는 걸 차단한다.
  lastTotpStep    BigInt?

  // ── 잠금 ──
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  disabledAt     DateTime? // 퇴임한 위원은 삭제가 아니라 비활성화 (감사 로그의 actorRef 가 남아야 함)

  approvals    TallyApproval[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// 개표 2인 승인(dual control).
/// 관리자 한 명이 혼자 개표를 실행할 수 없게 한다.
model TallyApproval {
  id         String    @id @default(uuid())
  electionId String
  election   Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  approvedAt DateTime  @default(now())

  // 한 사람이 두 번 승인해서 정족수를 채우는 걸 막는다.
  @@unique([electionId, adminId])
  @@index([electionId])
}


enum CheckpointKind {
  ROSTER_SEALED // 개시 시점 — 명부를 확정한다
  BALLOTS       // 투표 중 중간 확정
  FINAL         // 마감 시점 — 최종 표 집합을 확정한다
  RESULTS       // 개표 시점 — 결과를 확정한다
}

/// 무결성 체크포인트.
///
/// DB 쓰기 권한만 있으면 표를 넣거나 지우고, 결과 숫자를 고치고, 감사 로그에서
/// 흔적까지 지울 수 있다. 전부 한 DB 안에서 완결되므로 내부 정합성 검사로는 못 잡는다.
///
/// 그래서 각 단계마다 그 시점의 상태를 해시로 굳히고, 체크포인트끼리 이전 해시를
/// 물려 사슬로 만든다. 중간 하나만 손대도 그 뒤 전부가 어긋난다.
/// 사슬의 머리를 외부(참관인·TSA·블록체인)에 고정하면 협회 스스로도 되돌릴 수 없다.
model Checkpoint {
  id          String         @id @default(uuid())
  electionId  String
  election    Election       @relation(fields: [electionId], references: [id], onDelete: Cascade)

  seq         Int            // 1부터. 선거별로 이어진다
  kind        CheckpointKind

  ballotCount Int            // 이 시점까지 존재한 표의 수
  merkleRoot  String         // 그 표들의 머클 루트 (hex)
  rosterHash  String?        // 명부 해시 — ROSTER_SEALED 에서 채운다
  resultsHash String?        // 개표 결과 해시 — RESULTS 에서 채운다

  prevHash    String         // 직전 체크포인트의 hash (첫 번째는 64개의 0)
  hash        String         // 이 체크포인트 자체의 해시

  createdAt   DateTime       @default(now())
  anchors     Anchor[]

  @@unique([electionId, seq])
  @@index([electionId, createdAt])
}

/// 체크포인트 해시를 외부에 고정한 기록.
///
/// 고정하지 않으면 사슬 전체를 다시 만들어 끼워넣을 수 있다 —
/// 공격자가 DB 를 통째로 쥐고 있으면 체크포인트도 다시 계산하면 그만이기 때문이다.
/// **협회가 나중에 바꿀 수 없는 곳에 남기는 것**이 이 모델의 존재 이유다.
model Anchor {
  id           String     @id @default(uuid())
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  /// OBSERVERS(참관인 발송) | FILE(외부 저장소) | TSA(공인 타임스탬프) | BLOCKCHAIN
  target       String
  /// 트랜잭션 해시, 발송 기록 id, 파일 경로 등 나중에 대조할 수 있는 값
  reference    String
  detail       Json?
  anchoredAt   DateTime   @default(now())

  @@index([checkpointId])
}
