# ── DB ──────────────────────────────────────────────
# 계정을 둘로 나눈다. 인증은 밖에서 들어오는 사람만 막고, DB 에 직접 쓰는 사람은
# 막지 못한다 — 그 경로로는 API 검증이 아예 실행되지 않는다.
# 그래서 서버가 쓰는 계정에서 애초에 권한을 뺀다:
#   Ballot     INSERT 만 (표를 고치거나 지울 수 없다)
#   AuditLog   INSERT 만 (흔적을 지울 수 없다)
#   Checkpoint INSERT 만 (무결성 사슬을 덮을 수 없다)
#   AdminUser  INSERT 불가 (계정 생성은 CLI 로만)
#
# 계정 생성과 권한 적용:  npm run db:privileges --workspace=apps/api
# 실제로 막혔는지 확인:    npm run privilege:check --workspace=apps/api

# 런타임 — 권한을 깎은 계정. 풀링 연결(-pooler)을 쓴다.
DATABASE_URL="postgresql://kma_app:pass@host-pooler.../db?sslmode=require"
# 마이그레이션·운영자 스크립트 전용 — 소유자 계정.
# 앱 서버에 두지 말 것. 이 값을 쥔 사람은 위 제약을 전부 우회할 수 있다.
DIRECT_URL="postgresql://owner:pass@host.../db?sslmode=require"

# 앱 계정 이름과 비밀번호. 비워두면 db:privileges 가 만들어서 한 번 출력한다.
APP_DB_ROLE="kma_app"
APP_DB_PASSWORD=""

# ── 비밀값 ──────────────────────────────────────────
# 회원번호/휴대폰 해시용 pepper. 유출되면 명부 역추적이 가능해진다.
# 반드시 DB 와 다른 곳(KMS/Secret Manager)에 보관.
VOTER_ID_PEPPER="openssl rand -hex 32 로 생성한 값"
JWT_SECRET="openssl rand -hex 32 로 생성한 값"

# 투표 세션은 짧게. 로그인 후 실제 투표까지 몇 분이면 충분하다.
VOTE_SESSION_TTL="10m"

# ── SMS (본인인증 OTP) ──────────────────────────────
SMS_PROVIDER="mock"          # mock | naver_sens | nhn_toast | aligo
SMS_API_KEY=""
SMS_SENDER="0212345678"

REDIS_URL="redis://localhost:6379"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# ── 레이트 리밋 (분당, IP 기준) ───────────────────
# 공용 NAT(병원 의국) 뒤에서 여러 회원이 동시에 투표하는 상황을 견뎌야 한다.
# 1인당 방어선은 DB 의 otpSentCount 가 담당하므로 여기는 봇 차단용이다.
THROTTLE_OTP_REQUEST=30
THROTTLE_OTP_VERIFY=60
THROTTLE_GLOBAL=300
# 선관위원들이 같은 사무실 IP 를 쓰므로 너무 조이면 안 된다.
THROTTLE_ADMIN_LOGIN=30

# ── OTP 해싱 강도 ──────────────────────────────
# OWASP argon2id 최소 권장치. 라이브러리 기본값(64MiB/t=3/p=4)은 3분짜리 OTP 에는
# 과하고, 로그인 처리량을 코어당 9건/초까지 떨어뜨린다.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ── 관리자 ─────────────────────────────────────
ADMIN_SESSION_TTL="30m"
TOTP_ISSUER="협회장선거 선관위"
# 개표에 필요한 서로 다른 선관위원 승인 수. 1 로 낮추지 말 것.
TALLY_QUORUM=2

# ── 무결성 사슬 외부 고정 ─────────────────────
# 쉼표로 여러 개. FILE | OBSERVERS | BLOCKCHAIN
# 성격이 다른 둘 이상을 쓰는 게 맞다 — 한 곳만 쓰면 그곳이 단일 실패 지점이 된다.
ANCHOR_TARGETS="FILE"
# 참관인·후보 캠프 연락처. 선거 시작 전에 확정하고 공개할 것 —
# 사후에 고를 수 있으면 유리한 사람에게만 보낼 수 있다.
ANCHOR_OBSERVERS=""

# ── 감사 로그 외부 반출 ────────────────────────
# 로그를 같은 DB 에만 두면 DB 를 쥔 사람이 지울 수 있고, 지워졌다는 사실조차 알 수 없다.
# 줄마다 이전 줄의 해시를 물려 내보내므로 중간을 지우면 그 뒤가 전부 어긋난다.
# 쉼표로 여러 개. FILE | HTTP
AUDIT_SINKS="FILE"
# 인스턴스마다 별도 파일로 쓴다. 여러 인스턴스가 한 파일에 쓰면 사슬이 서로 끼어들어 깨진다.
AUDIT_EXPORT_DIR=""
# 재시작해도 같은 파일에 이어 쓰려면 인스턴스 이름을 고정한다.
AUDIT_INSTANCE_ID=""
# 외부 수집기로도 보내려면 (같은 서버 밖으로 나가야 진짜 반출이다)
AUDIT_EXPORT_URL=""
AUDIT_EXPORT_TOKEN=""

# ── 본인확인 서비스 ────────────────────────────
# 휴대폰+생년월일+OTP 로는 가족·직원 대리투표를 막지 못한다(생년월일은 가족이면 아는 값).
# 본인확인 서비스는 통신사 등록 명의와 대조하므로 그 경우까지 걸러진다.
#   off      쓰지 않음 (기본값)
#   optional 본인확인과 OTP 둘 다 허용 — 시범 운영용
#   required 본인확인만 허용. OTP 경로는 닫힌다 (열어두면 그게 우회로가 된다)
IDENTITY_VERIFICATION="off"
# mock | real   ※ mock 은 제출된 신원을 그대로 믿는다. production 에서는 기동이 거부된다.
IDENTITY_PROVIDER="mock"

# ── 블록체인 고정 (ANCHOR_TARGETS 에 BLOCKCHAIN 을 넣을 때만) ──
# 올라가는 것은 체크포인트 해시뿐이다. 표도 명부도 올리지 않는다 —
# 올리면 블록 타임스탬프가 초 단위로 영구히 남아 익명성 설계가 깨지고, 지울 수도 없다.
ANCHOR_CHAIN_RPC=""
# 연결된 체인이 맞는지 확인한다. 다르면 고정을 거부한다 (엉뚱한 체인에 남기면 아무도 못 찾는다).
ANCHOR_CHAIN_ID=""
# 고정용 지갑 개인키. **개표키와 같은 등급이다** — 털리면 가짜 고정을 만들 수 있다.
# 운영에서는 KMS/HSM 으로 옮기고 anchor.ts 의 loadPrivateKey() 를 교체할 것.
ANCHOR_CHAIN_PRIVATE_KEY=""
ANCHOR_CHAIN_CONFIRMATIONS="2"
ANCHOR_CHAIN_TIMEOUT_MS="180000"
# 참관인이 눌러볼 블록 탐색기 주소 (트랜잭션 해시가 뒤에 붙는다)
ANCHOR_CHAIN_EXPLORER=""
# 프라이빗/컨소시엄 체인이면 검증자를 누가 운영하는지 적는다. 이 값이 곧 신뢰의 근거다.
# 협회가 검증자를 전부 운영하면 보장이 0이다.
ANCHOR_CHAIN_TRUST_NOTE=""
